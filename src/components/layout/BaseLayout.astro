---
import "../../styles/theme.css";
import "../../styles/animations.css";
import "../../styles/global.css";

import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/roboto-mono/400.css";

import interLightWoff2 from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";
import interRegularWoff2 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interMediumWoff2 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import robotoMonoRegularWoff2 from "@fontsource/roboto-mono/files/roboto-mono-latin-400-normal.woff2?url";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
}

const { title, description, image = "/default-og-image.jpg", canonicalURL = Astro.url } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Preload critical fonts -->
    <link rel="preload" href={interLightWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interMediumWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={robotoMonoRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script is:inline>
      // Always use dark theme
      document.documentElement.setAttribute("data-theme", "dark");

      // Handle theme persistence during view transitions
      document.addEventListener("astro:before-swap", (ev) => {
        ev.newDocument.documentElement.setAttribute("data-theme", "dark");
      });

      // Add initial-load class
      document.addEventListener("DOMContentLoaded", () => {
        document.body.classList.add("initial-load");

        setTimeout(() => {
          document.body.classList.remove("initial-load");
          document.documentElement.classList.add("theme-transition");
        }, 1000);
      });
    </script>
  </head>
  <body>
    <div class="page-background" aria-hidden="true" transition:persist="page-background">
      <div class="page-background-glow page-background-glow--top" data-glow="top"></div>
      <div class="page-background-glow page-background-glow--bottom" data-glow="bottom"></div>
    </div>
    <main>
      <slot />
    </main>

    <script>
      const REDUCED_MOTION = window.matchMedia("(prefers-reduced-motion: reduce)");
      const LERP = 0.06;
      const SCROLL_Y_FACTOR = -0.08;
      const SCROLL_X_AMP = 36;
      const SCROLL_X_FREQ = 0.002;

      const state = {
        scrollY: 0,
        startedAt: performance.now(),
        top: { x: 0, y: 0 },
        bottom: { x: 0, y: 0 },
        rafId: 0,
        running: false,
      };

      function getGlows() {
        return {
          top: document.querySelector('[data-glow="top"]'),
          bottom: document.querySelector('[data-glow="bottom"]'),
        };
      }

      function resetGlows() {
        const { top, bottom } = getGlows();
        if (top instanceof HTMLElement) top.style.transform = "translate3d(0, 0, 0)";
        if (bottom instanceof HTMLElement) bottom.style.transform = "translate3d(0, 0, 0)";
        state.top.x = 0;
        state.top.y = 0;
        state.bottom.x = 0;
        state.bottom.y = 0;
      }

      function syncScroll() {
        state.scrollY = window.scrollY || window.pageYOffset || 0;
      }

      function tick(now) {
        if (!state.running) return;

        const { top, bottom } = getGlows();
        if (!(top instanceof HTMLElement) || !(bottom instanceof HTMLElement)) {
          state.rafId = window.requestAnimationFrame(tick);
          return;
        }

        const t = now - state.startedAt;
        const scrollY = state.scrollY;

        // Slow idle drift (periods ~18–25s)
        const idleTopX = Math.sin((t / 22000) * Math.PI * 2) * 26;
        const idleTopY = Math.cos((t / 18000) * Math.PI * 2) * 14;
        const idleBottomX = Math.sin((t / 25000) * Math.PI * 2 + 1.2) * 22;
        const idleBottomY = Math.cos((t / 20000) * Math.PI * 2 + 0.8) * 16;

        // Scroll parallax (opposite Y) + subtle horizontal sine
        const targetTopX = Math.sin(scrollY * SCROLL_X_FREQ) * SCROLL_X_AMP + idleTopX;
        const targetTopY = scrollY * SCROLL_Y_FACTOR + idleTopY;
        const targetBottomX =
          Math.sin(scrollY * SCROLL_X_FREQ + Math.PI * 0.5) * (SCROLL_X_AMP * 0.75) + idleBottomX;
        const targetBottomY = scrollY * (SCROLL_Y_FACTOR * 0.7) + idleBottomY;

        state.top.x += (targetTopX - state.top.x) * LERP;
        state.top.y += (targetTopY - state.top.y) * LERP;
        state.bottom.x += (targetBottomX - state.bottom.x) * LERP;
        state.bottom.y += (targetBottomY - state.bottom.y) * LERP;

        top.style.transform = `translate3d(${state.top.x.toFixed(2)}px, ${state.top.y.toFixed(2)}px, 0)`;
        bottom.style.transform = `translate3d(${state.bottom.x.toFixed(2)}px, ${state.bottom.y.toFixed(2)}px, 0)`;

        state.rafId = window.requestAnimationFrame(tick);
      }

      function stop(reset = true) {
        state.running = false;
        if (state.rafId) {
          window.cancelAnimationFrame(state.rafId);
          state.rafId = 0;
        }

        const previous = window.__ambientGlowAbort;
        if (previous instanceof AbortController) previous.abort();
        if (reset) resetGlows();
      }

      function start() {
        stop(false);
        state.running = true;
        syncScroll();

        const abort = new AbortController();
        window.addEventListener("scroll", syncScroll, { passive: true, signal: abort.signal });
        window.addEventListener("resize", syncScroll, { signal: abort.signal });
        window.__ambientGlowAbort = abort;

        state.rafId = window.requestAnimationFrame(tick);
      }

      function initAmbientGlow() {
        if (REDUCED_MOTION.matches) {
          stop(true);
          return;
        }
        start();
      }

      REDUCED_MOTION.addEventListener("change", initAmbientGlow);
      initAmbientGlow();
      document.addEventListener("astro:page-load", initAmbientGlow);
    </script>
  </body>
</html>
