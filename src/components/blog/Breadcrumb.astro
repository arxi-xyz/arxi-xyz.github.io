---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb-list">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="breadcrumb-item">
            {index > 0 && (
              <span class="breadcrumb-sep" aria-hidden="true">
                /
              </span>
            )}
            {item.href && !isLast ? (
              <a href={item.href} class="breadcrumb-link">
                {item.label}
              </a>
            ) : (
              <span class="breadcrumb-current" aria-current={isLast ? "page" : undefined}>
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem;
    min-width: 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: -0.02em;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    margin: 0;
  }

  .breadcrumb-item:last-child {
    flex: 1;
    min-width: 0;
  }

  .breadcrumb-sep {
    margin: 0 0.45rem;
    opacity: 0.55;
    flex-shrink: 0;
  }

  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  .breadcrumb-link::after {
    display: none;
  }

  .breadcrumb-link:hover {
    color: var(--text-color);
  }

  .breadcrumb-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--border-color);
    border-radius: 0.2rem;
  }

  .breadcrumb-current {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-muted);
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .breadcrumb-list {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-link {
      transition: none;
    }
  }
</style>
