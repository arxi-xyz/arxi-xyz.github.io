---
interface PostLink {
  title: string;
  href: string;
}

interface Props {
  prev?: PostLink;
  next?: PostLink;
  allPostsHref?: string;
  allPostsLabel?: string;
}

const {
  prev,
  next,
  allPostsHref = "/blog",
  allPostsLabel = "Back to all posts",
} = Astro.props;

const hasBoth = Boolean(prev && next);
---

<nav class="post-nav" aria-label="Adjacent articles">
  {
    (prev || next) && (
      <div class:list={["post-nav-adjacent", { single: !hasBoth }]}>
        {prev && (
          <a href={prev.href} class="post-nav-link prev" aria-label={`Previous article: ${prev.title}`}>
            <span class="post-nav-direction">&lt; Previous article</span>
            <span class="post-nav-title">{prev.title}</span>
          </a>
        )}
        {next && (
          <a href={next.href} class="post-nav-link next" aria-label={`Next article: ${next.title}`}>
            <span class="post-nav-direction">Next article &gt;</span>
            <span class="post-nav-title">{next.title}</span>
          </a>
        )}
      </div>
    )
  }

  <a href={allPostsHref} class="all-posts-link">{allPostsLabel}</a>
</nav>

<style>
  .post-nav {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .post-nav-adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .post-nav-adjacent.single {
    grid-template-columns: 1fr;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    color: var(--text-color);
    text-decoration: none;
    transition: opacity var(--transition-base);
  }

  .post-nav-link::after {
    display: none;
  }

  .post-nav-link:hover {
    opacity: 0.8;
  }

  .post-nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--border-color);
    border-radius: 0.25rem;
  }

  .post-nav-link.next {
    text-align: right;
    justify-self: end;
  }

  .post-nav-adjacent.single .post-nav-link.next {
    text-align: left;
    justify-self: start;
  }

  .post-nav-link.prev {
    justify-self: start;
  }

  .post-nav-direction {
    color: var(--text-muted);
    font-size: var(--text-sm);
    letter-spacing: -0.02em;
  }

  .post-nav-title {
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.03em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .all-posts-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .all-posts-link::after {
    display: none;
  }

  .all-posts-link:hover {
    color: var(--text-color);
  }

  .all-posts-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--border-color);
    border-radius: 0.25rem;
  }

  @media (max-width: 640px) {
    .post-nav-adjacent {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .post-nav-link.next,
    .post-nav-link.prev {
      text-align: left;
      justify-self: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-nav-link,
    .all-posts-link {
      transition: none;
    }
  }
</style>
