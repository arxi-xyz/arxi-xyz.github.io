---
interface Props {
  targetSelector?: string;
}

const { targetSelector = "[data-article-body]" } = Astro.props;
---

<div
  class="reading-progress"
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  data-reading-progress
  data-target={targetSelector}
>
  <div class="reading-progress-bar" data-reading-progress-bar></div>
</div>

<script>
  function initReadingProgress() {
    const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
    if (!progress) return;

    const bar = progress.querySelector<HTMLElement>("[data-reading-progress-bar]");
    const targetSelector = progress.dataset.target || "[data-article-body]";
    const target = document.querySelector<HTMLElement>(targetSelector);
    if (!bar || !target) return;

    const update = () => {
      const rect = target.getBoundingClientRect();
      const scrollable = target.offsetHeight - window.innerHeight;
      let value = 0;

      if (scrollable <= 0) {
        value = rect.bottom <= window.innerHeight ? 100 : 0;
      } else {
        const scrolled = -rect.top;
        value = Math.min(100, Math.max(0, (scrolled / scrollable) * 100));
      }

      bar.style.transform = `scaleX(${value / 100})`;
      progress.setAttribute("aria-valuenow", String(Math.round(value)));
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);

    document.addEventListener(
      "astro:before-preparation",
      () => {
        window.removeEventListener("scroll", update);
        window.removeEventListener("resize", update);
      },
      { once: true }
    );
  }

  initReadingProgress();
  document.addEventListener("astro:page-load", initReadingProgress);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 100;
    pointer-events: none;
    background: color-mix(in srgb, var(--border-color) 55%, transparent);
  }

  .reading-progress-bar {
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: color-mix(in srgb, var(--link-color) 80%, white 15%);
    opacity: 0.95;
    transition: transform 80ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress-bar {
      transition: none;
    }
  }
</style>
